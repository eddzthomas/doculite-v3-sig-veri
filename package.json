{
  "name": "doculite",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "pnpm -r lint && biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "build": "pnpm -r build",
    "validate:docs": "node scripts/validate-docs.mjs docs",
    "validate:compose": "node scripts/validate-compose-digests.mjs deploy/upstream-versions.json deploy/local/compose.yaml"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "node-forge": "^1.4.0",
    "node-signpdf": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "vitest": "^5.0.0"
  }
}
